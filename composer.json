{
    "name": "atelier/layout",
    "description": "Renderer-agnostic spatial composition primitives: geometry, box constraints, grids, text layout, and links between boxes",
    "license": "MIT",
    "type": "library",
    "homepage": "https://ateliersvg.com/layout/",
    "keywords": [
        "layout",
        "spatial",
        "geometry",
        "grid",
        "flex",
        "text-layout",
        "constraints",
        "composition"
    ],
    "support": {
        "issues": "https://github.com/ateliersvg/layout/issues",
        "source": "https://github.com/ateliersvg/layout"
    },
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com",
            "homepage": "https://smnandre.dev"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Atelier\\Layout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atelier\\Layout\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix --dry-run --diff --sequential",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "vendor/bin/phpstan analyse --memory-limit=-1",
        "test": "vendor/bin/phpunit"
    }
}
